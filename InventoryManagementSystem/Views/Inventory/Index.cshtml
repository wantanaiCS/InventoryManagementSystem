@model InventoryManagementSystem.Models.PagedResult<InventoryManagementSystem.Models.InventoryTransaction>
@using InventoryManagementSystem
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Inventory.HistoryTitle"];
    var type = ViewBag.Type as string;
}

<div class="container-fluid mt-4">
    <partial name="_Alerts" />
    <div class="d-flex justify-content-between mb-3">
        <h2><i class="fas fa-exchange-alt"></i> @L["Inventory.TransactionsTitle"]</h2>
        <div>
            <a asp-controller="Inventory" asp-action="Receive" class="btn btn-success"><i class="fas fa-arrow-down"></i> @L["Inventory.Receive"]</a>
            <a asp-controller="Inventory" asp-action="Dispense" class="btn btn-warning"><i class="fas fa-arrow-up"></i> @L["Inventory.Dispense"]</a>
        </div>
    </div>

    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(type) ? "btn-primary" : "btn-outline-primary")">@L["Inventory.Filter.All"]</a>
        <a asp-action="Index" asp-route-type="IN" class="btn btn-sm @(type == "IN" ? "btn-success" : "btn-outline-success")">@L["Inventory.Filter.In"]</a>
        <a asp-action="Index" asp-route-type="OUT" class="btn btn-sm @(type == "OUT" ? "btn-warning" : "btn-outline-warning")">@L["Inventory.Filter.Out"]</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>@L["Inventory.Col.Date"]</th>
                    <th>@L["Inventory.Col.Type"]</th>
                    <th>@L["Inventory.Col.Product"]</th>
                    <th>@L["Inventory.Col.Qty"]</th>
                    <th>@L["Inventory.Col.By"]</th>
                    <th>@L["Inventory.Col.Shift"]</th>
                    <th>@L["Inventory.Col.Notes"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Items)
            {
                <tr>
                    <td>@t.CreatedDate.ToString("g")</td>
                    <td><span class="badge @(t.TransactionType == "IN" ? "bg-success" : "bg-warning")">@t.TransactionType</span></td>
                    <td>@t.Product?.ProductName</td>
                    <td>@t.Quantity</td>
                    <td>@t.CreatedByUser?.Username</td>
                    <td>@t.Shift</td>
                    <td>@t.Notes</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination">
            @if (Model.HasPrevious)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-type="@type">@L["Inventory.Pager.Previous"]</a></li>
            }
            <li class="page-item disabled"><span class="page-link">@string.Format(L["Inventory.Pager.PageOf"], Model.Page, Model.TotalPages)</span></li>
            @if (Model.HasNext)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-type="@type">@L["Inventory.Pager.Next"]</a></li>
            }
        </ul>
    </nav>
</div>
