@model InventoryManagementSystem.ViewModels.InventoryTransactionFormViewModel
@using InventoryManagementSystem
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Inventory.ReceiveTitle"];
    var products = ViewBag.Products as IEnumerable<InventoryManagementSystem.Models.Product> ?? Enumerable.Empty<InventoryManagementSystem.Models.Product>();
    var shifts = ViewBag.Shifts as string[] ?? Array.Empty<string>();
}

<div class="container mt-4">
    <h2><i class="fas fa-arrow-down text-success"></i> @L["Inventory.ReceiveTitle"]</h2>
    <partial name="_Alerts" />
    <form asp-controller="Inventory" asp-action="Receive" method="post" class="col-md-6">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="ProductId" class="form-label">@L["Inventory.Form.Product"] *</label>
            <select asp-for="ProductId" class="form-select">
                <option value="">@L["Inventory.Form.Select"]</option>
                @foreach (var p in products)
                {
                    <option value="@p.ProductId">@p.ProductName (@p.ProductCode) — @L["Inventory.Form.Stock"]: @p.CurrentStock</option>
                }
            </select>
        </div>
        <div class="mb-3"><label asp-for="Quantity" class="form-label">@L["Inventory.Form.Quantity"] *</label><input asp-for="Quantity" class="form-control" type="number" min="1" /></div>
        <div class="mb-3">
            <label asp-for="Shift" class="form-label">@L["Inventory.Form.Shift"]</label>
            <select asp-for="Shift" class="form-select">@foreach (var s in shifts) { <option value="@s">@s</option> }</select>
        </div>
        <div class="mb-3"><label asp-for="Notes" class="form-label">@L["Inventory.Form.Notes"]</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
        <button type="submit" class="btn btn-success">@L["Inventory.Form.RecordIn"]</button>
        <a asp-action="Index" class="btn btn-secondary">@L["Common.Cancel"]</a>
    </form>
</div>
