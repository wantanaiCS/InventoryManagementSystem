@model IEnumerable<InventoryManagementSystem.Models.Employee>
@{
    ViewData["Title"] = "Pending Employee Approvals";
}

<div class="container mt-4">
    <h2><i class="fas fa-clock"></i> คำขอสมัครพนักงาน (รออนุมัติ)</h2>
    <p class="text-muted">ระบบ Auto — พนักงานสมัครเอง รอ Admin กดอนุมัติ</p>
    <partial name="_Alerts" />
    <a asp-action="Index" class="btn btn-secondary mb-3">← กลับรายชื่อพนักงาน</a>

    @if (Model.Any())
    {
        @foreach (var e in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@e.FullName</h5>
                    <p class="mb-1"><strong>ตำแหน่ง:</strong> @e.Position</p>
                    <p class="mb-1"><strong>บัญชี:</strong> @e.User?.Username (@e.User?.Email)</p>
                    <p class="mb-1"><strong>แผนก:</strong> @(e.Department?.DepartmentName ?? "—")</p>
                    <p class="mb-1"><strong>กะ:</strong> @e.Shift | <strong>เริ่มงาน:</strong> @e.HireDate.ToString("dd/MM/yyyy")</p>
                    <div class="mt-2 d-flex gap-2">
                        <form asp-action="Approve" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@e.EmployeeId" />
                            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> อนุมัติ</button>
                        </form>
                        <form asp-action="Reject" method="post" class="d-inline flex-grow-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@e.EmployeeId" />
                            <div class="input-group input-group-sm">
                                <input type="text" name="reason" class="form-control" placeholder="เหตุผล (ถ้าปฏิเสธ)" />
                                <button type="submit" class="btn btn-outline-danger">ปฏิเสธ</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-success">ไม่มีคำขอรออนุมัติ</div>
    }
</div>
