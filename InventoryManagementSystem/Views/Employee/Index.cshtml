@model InventoryManagementSystem.Models.PagedResult<InventoryManagementSystem.Models.Employee>
@using InventoryManagementSystem.ViewModels
@{
    ViewData["UseFullWidthPage"] = true;
    ViewData["Title"] = "Employee Management";
    var filter = ViewBag.Filter as EmployeeFilterViewModel ?? new EmployeeFilterViewModel();
    var departments = ViewBag.Departments as IEnumerable<InventoryManagementSystem.Models.Department> ?? Enumerable.Empty<InventoryManagementSystem.Models.Department>();
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container-fluid mt-4">
    <partial name="_Alerts" />
    <div class="row mb-4">
        <div class="col-md-6"><h2><i class="fas fa-users"></i> Employees</h2></div>
        <div class="col-md-6 text-end">
            @if (isAdmin)
            {
                <a asp-action="Onboard" class="btn btn-success"><i class="fas fa-magic"></i> Onboarding Wizard</a>
                <a asp-action="Create" class="btn btn-primary"><i class="fas fa-user-plus"></i> Add Employee</a>
                <a asp-controller="Export" asp-action="Employees" class="btn btn-outline-success"><i class="fas fa-file-excel"></i> Export</a>
            }
        </div>
    </div>

    <form method="get" class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-3">
                <input name="SearchTerm" class="form-control" placeholder="Search name, position, username" value="@filter.SearchTerm" />
            </div>
            <div class="col-md-2">
                <select name="DepartmentId" class="form-select">
                    <option value="">All departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.DepartmentId" selected="@(filter.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input name="Position" class="form-control" placeholder="Position" value="@filter.Position" />
            </div>
            <div class="col-md-2">
                <select name="IsActive" class="form-select">
                    <option value="">All status</option>
                    <option value="true" selected="@(filter.IsActive == true)">Active</option>
                    <option value="false" selected="@(filter.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter"></i> Filter</button>
            </div>
            <div class="col-md-1">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </div>
    </form>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Position</th>
                        <th>Department</th>
                        <th>Shift</th>
                        <th>Status</th>
                        <th>Account</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td><strong>@e.FullName</strong></td>
                        <td>@e.Position</td>
                        <td>@e.Department?.DepartmentName</td>
                        <td>@e.Shift</td>
                        <td>
                            @if (e.IsActive)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td><span class="badge bg-info">@e.User?.Username</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@e.EmployeeId" class="btn btn-sm btn-info"><i class="fas fa-eye"></i></a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@e.EmployeeId" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@e.EmployeeId" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <nav>
            <ul class="pagination">
                @if (Model.HasPrevious)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> {
                        ["SearchTerm"] = filter.SearchTerm, ["DepartmentId"] = filter.DepartmentId?.ToString(),
                        ["Position"] = filter.Position, ["IsActive"] = filter.IsActive?.ToString(), ["Page"] = (Model.Page - 1).ToString()
                    })">Previous</a></li>
                }
                <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span></li>
                @if (Model.HasNext)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> {
                        ["SearchTerm"] = filter.SearchTerm, ["DepartmentId"] = filter.DepartmentId?.ToString(),
                        ["Position"] = filter.Position, ["IsActive"] = filter.IsActive?.ToString(), ["Page"] = (Model.Page + 1).ToString()
                    })">Next</a></li>
                }
            </ul>
        </nav>
    }
    else
    {
        <div class="alert alert-info">No employees found.</div>
    }
</div>
