@{
    ViewData["Title"] = L["Home.Title"];
}

<div class="text-center py-5">
    <h1 class="display-5"><i class="fas fa-warehouse"></i> @L["App.Title"]</h1>
    <p class="lead">@L["Home.Description"]</p>
    @if (Context.Session.GetString(InventoryManagementSystem.Helpers.SessionKeys.UserId) != null)
    {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg mt-3">@L["Nav.Dashboard"]</a>
    }
    else
    {
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg mt-3 me-2">@L["Auth.Login"]</a>
        <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-secondary btn-lg mt-3">@L["Auth.Register"]</a>
    }
</div>
