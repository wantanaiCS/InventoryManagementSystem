@model IEnumerable<InventoryManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Furniture Products";
    var categories = ViewBag.Categories as IEnumerable<InventoryManagementSystem.Models.Category> ?? Enumerable.Empty<InventoryManagementSystem.Models.Category>();
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container-fluid mt-4">
    <partial name="_Alerts" />
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-couch"></i> สินค้าเฟอร์นิเจอร์</h2>
            <p class="text-muted mb-0">จัดการสต็อกเฟอร์นิเจอร์ในคลัง — รับ–จ่ายผ่านเมนู Inventory</p>
        </div>
        <div class="col-md-4 text-end">
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> เพิ่มสินค้าใหม่
                </a>
            }
            else
            {
                <span class="badge bg-secondary align-middle">ดูอย่างเดียว — สร้างสินค้าต้องเป็น Admin</span>
            }
        </div>
    </div>

    <form method="get" class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" name="searchTerm" class="form-control" placeholder="ค้นหารหัส / ชื่อสินค้า..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">ทุกกลุ่มเฟอร์นิเจอร์</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId" selected="@(ViewBag.CategoryId as int? == c.CategoryId)">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-search"></i> ค้นหา</button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>รหัส</th>
                        <th>ชื่อสินค้า</th>
                        <th>กลุ่ม</th>
                        <th>วัสดุ / สี</th>
                        <th>ขนาด (ก×ล×ส)</th>
                        <th>ราคา</th>
                        <th>สต็อก</th>
                        <th>ที่เก็บ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@p.ProductCode</strong></td>
                        <td>@p.ProductName</td>
                        <td>@p.Category?.CategoryName</td>
                        <td>@p.Material / @p.Color</td>
                        <td>@p.DimensionDisplay</td>
                        <td>฿@p.Price.ToString("N0")</td>
                        <td>
                            @if (p.CurrentStock <= 5)
                            { <span class="badge bg-danger">@p.CurrentStock @p.Unit</span> }
                            else
                            { <span class="badge bg-success">@p.CurrentStock @p.Unit</span> }
                        </td>
                        <td>@p.WarehouseLocation</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-info"><i class="fas fa-eye"></i></a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@p.ProductId" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-couch"></i> ยังไม่มีสินค้าเฟอร์นิเจอร์ในระบบ
            @if (isAdmin)
            {
                <a asp-action="Create" class="alert-link">เพิ่มสินค้าแรก</a>
            }
        </div>
    }
</div>
