@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-circle"></i> My Profile
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <p class="text-muted"><strong>Username:</strong></p>
                        </div>
                        <div class="col-md-9">
                            <p>@ViewBag.Username</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <p class="text-muted"><strong>Role:</strong></p>
                        </div>
                        <div class="col-md-9">
                            <p>
                                <span class="badge bg-info">@ViewBag.Role</span>
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                        <a href="@Url.Action("Logout")" class="btn btn-danger">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
