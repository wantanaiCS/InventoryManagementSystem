@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="text-danger">Delete Product</h2>
            <hr />

            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> 
                Are you sure you want to delete this product? This action cannot be undone.
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Product Code</dt>
                        <dd class="col-sm-9">@Model.ProductCode</dd>

                        <dt class="col-sm-3">Product Name</dt>
                        <dd class="col-sm-9">@Model.ProductName</dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">@Model.Category?.CategoryName</dd>

                        <dt class="col-sm-3">Price</dt>
                        <dd class="col-sm-9">฿@Model.Price.ToString("0.00")</dd>

                        <dt class="col-sm-3">Current Stock</dt>
                        <dd class="col-sm-9">@Model.CurrentStock units</dd>

                        <dt class="col-sm-3">Created Date</dt>
                        <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                        }
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" asp-for="ProductId" />
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete Product
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
