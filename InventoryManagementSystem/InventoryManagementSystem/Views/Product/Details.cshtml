@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Product Details</h2>
            <hr />

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5 class="text-muted">Product Code</h5>
                            <p class="h6">@Model.ProductCode</p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Product Name</h5>
                            <p class="h6">@Model.ProductName</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5 class="text-muted">Category</h5>
                            <p class="h6">@Model.Category?.CategoryName</p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Price</h5>
                            <p class="h6"><span class="badge bg-info">฿@Model.Price.ToString("0.00")</span></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5 class="text-muted">Current Stock</h5>
                            <p class="h6">
                                @if (Model.CurrentStock < 10)
                                {
                                    <span class="badge bg-danger">@Model.CurrentStock units</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@Model.CurrentStock units</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Created Date</h5>
                            <p class="h6">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-3">
                            <h5 class="text-muted">Description</h5>
                            <p>@Model.Description</p>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <a href="@Url.Action("Edit", new { id = Model.ProductId })" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a href="@Url.Action("Delete", new { id = Model.ProductId })" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </a>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
