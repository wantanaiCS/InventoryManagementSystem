@model IEnumerable<InventoryManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Product Management";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>Products</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Product
            </a>
        </div>
    </div>

    <!-- Search Form -->
    <div class="row mb-3">
        <div class="col-md-12">
            <form method="get" action="@Url.Action("Index")" class="input-group">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by product name or code..." 
                       value="@ViewBag.SearchTerm">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fas fa-search"></i> Search
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Clear</a>
            </form>
        </div>
    </div>

    <!-- Products Table -->
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td><strong>@product.ProductCode</strong></td>
                            <td>@product.ProductName</td>
                            <td>@product.Category?.CategoryName</td>
                            <td>
                                <span class="badge bg-info">฿@product.Price.ToString("0.00")</span>
                            </td>
                            <td>
                                @if (product.CurrentStock < 10)
                                {
                                    <span class="badge bg-danger">@product.CurrentStock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@product.CurrentStock</span>
                                }
                            </td>
                            <td>@product.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = product.ProductId })" 
                                   class="btn btn-sm btn-info" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = product.ProductId })" 
                                   class="btn btn-sm btn-warning" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = product.ProductId })" 
                                   class="btn btn-sm btn-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No products found. 
            <a href="@Url.Action("Create")">Create one now</a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-sm {
        margin: 0 2px;
    }
</style>
