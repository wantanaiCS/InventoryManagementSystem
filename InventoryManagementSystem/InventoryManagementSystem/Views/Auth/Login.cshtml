@{
    ViewData["Title"] = L["Auth.Login"];
    ViewData["UseFullWidthPage"] = true;
    ViewData["BodyClass"] = "auth-body";

    var postedUsername = Context.Request.HasFormContentType
        ? Context.Request.Form["username"].ToString()
        : string.Empty;
}

<section class="auth-shell" aria-labelledby="auth-title">
    <aside class="auth-visual" aria-label="@L["Auth.SystemOverview"]">
        <div class="auth-brand">
            <span class="auth-brand-mark">
                <i class="fas fa-warehouse" aria-hidden="true"></i>
            </span>
            <span>@L["App.Title"]</span>
        </div>

        <div class="auth-visual-copy">
            <p class="auth-eyebrow">@L["Auth.SecureAccess"]</p>
            <h1>@L["Auth.ControlStock"]</h1>
            <p>@L["Auth.SignInDescription"]</p>
        </div>

        <div class="auth-metrics" aria-label="System highlights">
            <div>
                <strong>Real-time</strong>
                <span>@L["Auth.Highlights1"]</span>
            </div>
            <div>
                <strong>Role based</strong>
                <span>@L["Auth.Highlights2"]</span>
            </div>
            <div>
                <strong>Audit ready</strong>
                <span>@L["Auth.Highlights3"]</span>
            </div>
        </div>
    </aside>

    <div class="auth-panel-wrap">
        <div class="auth-card">
            <div class="auth-card-header">
                <span class="auth-card-icon">
                    <i class="fas fa-lock" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="auth-kicker">@L["Auth.WelcomeBack"]</p>
                    <h2 id="auth-title">@L["Auth.LoginTitle"]</h2>
                </div>
            </div>

            <form class="auth-form" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-validation" role="alert"></div>

                <div class="auth-field">
                    <label for="username">@L["Auth.Username"] <span>*</span></label>
                    <div class="auth-input">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <input id="username"
                               type="text"
                               name="username"
                               class="form-control"
                               placeholder="@L["Auth.EnterUsername"]"
                               value="@postedUsername"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <div class="auth-field">
                    <label for="password">@L["Auth.Password"] <span>*</span></label>
                    <div class="auth-input">
                        <i class="fas fa-key" aria-hidden="true"></i>
                        <input id="password"
                               type="password"
                               name="password"
                               class="form-control"
                               placeholder="@L["Auth.EnterPassword"]"
                               autocomplete="current-password"
                               required />
                        <button class="auth-password-toggle"
                                type="button"
                                data-password-toggle
                                aria-label="@L["Auth.Password"]"
                                aria-controls="password">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="auth-submit">
                    <span>@L["Auth.SignIn"]</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            <p class="auth-switch">
                @L["Auth.NoAccount"]
                <a href="@Url.Action("Register")">@L["Auth.CreateOne"]</a>
            </p>
        </div>
    </div>
</section>
